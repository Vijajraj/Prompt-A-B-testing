GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
GROQ_MODEL=llama-3.1-8b-instant
PROMOTE_MODEL=meta-llama/llama-3.3-70b-instruct:free
SCORER=auto
MODEL_BUCKET=model-artifacts

# Local MLflow (default)
MLFLOW_TRACKING_URI=./mlruns

# Global MLflow via DagsHub (switch when deploying)
# MLFLOW_TRACKING_URI=https://dagshub.com/yourusername/prompt-ab-tester.mlflow
# DAGSHUB_USERNAME=your_dagshub_username
# DAGSHUB_TOKEN=your_dagshub_token
